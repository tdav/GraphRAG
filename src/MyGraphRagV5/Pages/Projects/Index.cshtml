@page
@model MyGraphRagV5.Pages.Projects.IndexModel
@{
    ViewData["Title"] = "Проекты";
}

<div class="flex flex-col gap-6">
    <div class="flex items-center justify-between">
        <h2 class="text-lg font-semibold">Проекты</h2>
        <a href="/Projects/Create" class="btn-default" style="border-color: var(--color-accent); color: var(--color-accent);">
            Новый проект
        </a>
    </div>

    <section class="ember-panel p-6">
        @if (Model.Rows.Count == 0)
        {
            <div class="ember-well p-6 text-center text-ink-muted">
                <p>Проектов пока нет.</p>
                <p class="mt-1 text-xs">Нажмите «Новый проект», чтобы создать первый и начать индексацию.</p>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm">
                    <thead>
                        <tr class="border-b border-hairline text-xs uppercase tracking-wide text-ink-muted">
                            <th class="py-2 pr-4 font-medium">Название</th>
                            <th class="py-2 pr-4 font-medium">Исходная папка</th>
                            <th class="py-2 pr-4 font-medium">Создан</th>
                            <th class="py-2 pr-4 font-medium">Последний запуск</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Rows)
                        {
                            <tr class="border-b border-hairline last:border-0 hover:bg-surface/60">
                                <td class="py-2.5 pr-4 font-medium">
                                    <a href="/Projects/Details/@row.Project.Id" class="hover:text-accent">@row.Project.Name</a>
                                </td>
                                <td class="py-2.5 pr-4 data-mono text-xs">@row.Project.SourceFolder</td>
                                <td class="py-2.5 pr-4 data-mono text-xs">@row.Project.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                <td class="py-2.5 pr-4">
                                    @if (row.LatestRun is { } run)
                                    {
                                        var (cssClass, label) = StatusBadge.ForRunStatus(run.Status);
                                        <span class="@cssClass">@label</span>
                                    }
                                    else
                                    {
                                        <span class="text-xs text-ink-muted">&mdash;</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
