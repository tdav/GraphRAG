@page
@model MyGraphRagV5.Pages.IndexModel
@{
    ViewData["Title"] = "Дашборд";
}

<div class="flex flex-col gap-6">
    <section class="grid grid-cols-1 gap-4 sm:grid-cols-3">
        <div class="ember-panel p-6">
            <p class="text-xs font-medium uppercase tracking-wide text-ink-muted">Проекты</p>
            <p class="mt-2 text-2xl font-semibold">@Model.Projects.Count</p>
        </div>
        <div
            id="health-panel"
            class="ember-panel p-6 sm:col-span-2"
            hx-get="/Health/Panel"
            hx-trigger="load, every 5s"
            hx-swap="innerHTML">
            <p class="text-xs font-medium uppercase tracking-wide text-ink-muted">Состояние сервисов</p>
            <p class="mt-3 text-sm text-ink-muted">Загрузка…</p>
        </div>
    </section>

    <section class="ember-panel p-6">
        <h2 class="text-base font-semibold">Проекты</h2>
        @if (Model.Projects.Count == 0)
        {
            <div class="ember-well mt-4 p-6 text-center text-ink-muted">
                <p>Проектов пока нет.</p>
                <p class="mt-1 text-xs">Создайте первый проект на странице «Проекты», чтобы начать индексацию.</p>
            </div>
        }
        else
        {
            <div class="mt-4 overflow-x-auto">
                <table class="w-full text-left text-sm">
                    <thead>
                        <tr class="border-b border-hairline text-xs uppercase tracking-wide text-ink-muted">
                            <th class="py-2 pr-4 font-medium">Название</th>
                            <th class="py-2 pr-4 font-medium">Исходная папка</th>
                            <th class="py-2 pr-4 font-medium">Создан</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var project in Model.Projects)
                        {
                            <tr class="border-b border-hairline last:border-0 hover:bg-surface/60">
                                <td class="py-2.5 pr-4 font-medium">@project.Name</td>
                                <td class="py-2.5 pr-4 data-mono text-xs">@project.SourceFolder</td>
                                <td class="py-2.5 pr-4 data-mono text-xs">@project.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="ember-panel p-6">
        <h2 class="text-base font-semibold">Последние запуски индексации</h2>
        @if (Model.RecentRuns.Count == 0)
        {
            <div class="ember-well mt-4 p-6 text-center text-ink-muted">
                <p>Запусков индексации пока не было.</p>
            </div>
        }
        else
        {
            <div class="mt-4 overflow-x-auto">
                <table class="w-full text-left text-sm">
                    <thead>
                        <tr class="border-b border-hairline text-xs uppercase tracking-wide text-ink-muted">
                            <th class="py-2 pr-4 font-medium">Проект</th>
                            <th class="py-2 pr-4 font-medium">Статус</th>
                            <th class="py-2 pr-4 font-medium">Начат</th>
                            <th class="py-2 pr-4 font-medium">Завершён</th>
                            <th class="py-2 pr-4 font-medium">Документы</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.RecentRuns)
                        {
                            var (cssClass, label) = StatusBadge.ForRunStatus(row.Run.Status);
                            <tr class="border-b border-hairline last:border-0 hover:bg-surface/60">
                                <td class="py-2.5 pr-4 font-medium">@row.ProjectName</td>
                                <td class="py-2.5 pr-4"><span class="@cssClass">@label</span></td>
                                <td class="py-2.5 pr-4 data-mono text-xs">@row.Run.StartedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                <td class="py-2.5 pr-4 data-mono text-xs">@(row.Run.CompletedAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                                <td class="py-2.5 pr-4 data-mono text-xs">@(row.Run.DocumentCount?.ToString() ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
